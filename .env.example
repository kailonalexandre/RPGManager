# Database
# Neon example:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require"
DATABASE_URL=""
NODE_ENV="development"

# Local Docker PostgreSQL fallback
POSTGRES_DB="rpgmanager"
POSTGRES_USER="rpgmanager"
POSTGRES_PASSWORD="rpgmanager"
POSTGRES_PORT="5432"

# HTTP ports exposed by Docker Compose
API_PORT="5000"
FRONTEND_PORT="8080"

# Frontend/API integration
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:8080"
VITE_API_BASE_URL="http://localhost:5000/api"

# JWT
JWT_ISSUER="RpgManager"
JWT_AUDIENCE="RpgManager"
JWT_SECRET=""
JWT_EXPIRATION_MINUTES="120"

# Optional auth placeholders for hosts/frameworks that need them
NEXTAUTH_SECRET=""
NEXTAUTH_URL=""

# Local upload storage
LOCAL_FILE_STORAGE_ROOT_PATH="/app/wwwroot/uploads"
LOCAL_FILE_STORAGE_PUBLIC_BASE_PATH="/uploads"
LOCAL_FILE_STORAGE_MAX_BYTES="5242880"

# Open5e SRD spell import
OPEN5E_SPELLS_URL="https://api.open5e.com/v2/spells/"
OPEN5E_DOCUMENT_KEYS="srd-2014,srd-2024"
OPEN5E_PAGE_SIZE="100"
OPEN5E_MAX_PAGES="100"
OPEN5E_TIMEOUT_SECONDS="30"
